{
  "name": "lanche-confraternizacao",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test src/lib.test.js",
    "deploy": "npm test && npm run test:rules && npm run build && firebase deploy",
    "emu": "firebase emulators:start --project demo-lanche",
    "dev:emu": "VITE_EMULATOR=1 VITE_SITE_URL=http://localhost:5199 VITE_FB_PROJECT_ID=demo-lanche VITE_FB_API_KEY=demo vite",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules 'node --test tests/rules.test.js'"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}
